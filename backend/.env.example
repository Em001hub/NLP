# Get a free key at https://gnews.io (100 requests/day free tier)
GNEWS_API_KEY=your_gnews_api_key_here

# Groq API Key for high-speed AI graph extraction & entity intelligence
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Secret used to sign login session tokens - change this to any random string
JWT_SECRET=change_this_to_a_random_secret_string

# How long a login session lasts, in minutes
JWT_EXPIRE_MINUTES=720
